# NIA Backend — Environment Variables
# Copy to .env and fill in real values.  NEVER commit .env.
# Architecture: OpenYabby-inspired Android-first AI agent (v0.3)

# ── Required ──────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-at-least-32-chars

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./nia.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nia

# ── AI / LLM — set EXACTLY ONE provider ──────────────────────────────────
#
# Option A: OpenAI (default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# Option B: Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Option C: OpenRouter — recommended for open-source/free models
# Inspired by dejevu's LLMPolicy default (dejevu/policy.py)
# Get a free key at https://openrouter.ai/keys
# Free models include: mistralai/mistral-7b-instruct:free, meta-llama/llama-3-8b-instruct:free
# LLM_PROVIDER=openrouter
# LLM_MODEL=mistralai/mistral-7b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-...

# Option D: Local OpenAI-compatible server (Ollama, LM Studio, vLLM)
# Perfect for fully offline / on-device inference
# LLM_PROVIDER=local
# LLM_MODEL=llama3.2          # or whatever model name your server uses
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL_API_KEY=       # leave blank for Ollama

# LLM tuning (optional — defaults shown)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512

# ── Web Search / Browser Agent ────────────────────────────────────────────
# Inspired by dejevu's browser agent architecture
# "basic" = httpx text fetch (no browser, default)
# "dejevu" = future CDP-based browser agent (stub in v0.3)
WEB_AGENT_PROVIDER=basic

# Future: Chrome CDP endpoint for DejevuProvider
# DEJEVU_CDP_URL=http://localhost:9222
# DEJEVU_MAX_ACTIONS=40
# DEJEVU_MAX_REQUESTS=80

# ── Arc / Onchain (all optional — Arc features degrade gracefully if unset) ──
# Arc is Circle's blockchain where USDC is the native gas token.
# DO NOT put private keys in the APK. Backend only.
# ARC_RPC_URL=https://rpc.arc.io
# ARC_CHAIN_ID=      # Arc testnet or mainnet chain ID
# ARC_WALLET_ADDRESS= # Nia's Arc wallet address (public, safe in env)

# ── Security ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
ALLOWED_WEB_HOSTS=   # comma-separated; empty = all allowed (dev only)
DEBUG=false
