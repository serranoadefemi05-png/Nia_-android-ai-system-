<?xml version="1.0" encoding="utf-8"?>
<!--
    NIA Android — AndroidManifest.xml
    Package: ai.nia.assistant

    Permission philosophy:
    - Only permissions actually used by MVP tools are declared.
    - Dangerous permissions are requested at RUNTIME (just-in-time) by PermissionManager.
    - The AI orchestrator NEVER executes a tool without first verifying permissions.
    - Each permission group is annotated with the tool that requires it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ─── Network (always required — backend + web search) ──────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ─── Voice input (core to NIA — requested at launch) ──────────────── -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ─── take_screenshot: MediaProjection foreground service ──────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- ─── search_local_files: MediaStore / Storage Access Framework ─────── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_DOCUMENTS"
        android:minSdkVersion="33" />

    <!-- ─── create_reminder: AlarmManager ────────────────────────────────── -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:minSdkVersion="31" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ─── POST_NOTIFICATIONS (Android 13+) ─────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!-- ─── Haptic feedback ────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ─── YELLOW: NotificationListenerService (opt-in, not auto-requested) -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <application
        android:name=".NiaApplication"
        android:label="NIA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NIA"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ── Main Activity ──────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── MediaProjection / Screenshot foreground service ───────────── -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ── Alarm/Reminder receiver ───────────────────────────────────── -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.nia.assistant.ALARM_TRIGGERED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Notification listener (optional, user must grant in settings) -->
        <service
            android:name=".service.NiaNotificationListenerService"
            android:exported="true"
            android:label="NIA Notification Reader"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
