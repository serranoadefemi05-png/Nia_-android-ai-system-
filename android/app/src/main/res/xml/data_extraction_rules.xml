<?xml version="1.0" encoding="utf-8"?>
<!--
    NIA Android — Data Extraction Rules
    Prevents Android Auto Backup from including sensitive NIA data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nia_secure_prefs" />
        <exclude domain="file" path="." />
        <exclude domain="database" path="nia_memory.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nia_secure_prefs" />
        <exclude domain="database" path="nia_memory.db" />
    </device-transfer>
</data-extraction-rules>
