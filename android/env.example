# ─────────────────────────────────────────────────────────────────────────────
# NIA Android — env.example
#
# Android apps do not load env files at runtime — this file documents every
# value the Android build system and CI pipeline need.
#
# For local development: copy values into android/local.properties.
# For CI: inject as environment variables or GitHub/GitLab secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Build configuration ──────────────────────────────────────────────────────

# NIA backend base URL injected into BuildConfig.NIA_BACKEND_URL at compile time.
# Emulator default:
NIA_BACKEND_URL=http://10.0.2.2:8000
# Physical device / staging:
# NIA_BACKEND_URL=https://staging-api.nia.yourdomain.com

# ─── Release signing (CI only) ────────────────────────────────────────────────
# Never store keystore passwords in this file for local development.
# Use Android Studio's signing wizard instead.

# Path to the release keystore (relative to android/app/).
# KEYSTORE_FILE=nia-release.jks

# Keystore password (CI secret — never commit a real value).
# KEYSTORE_PASSWORD=

# Key alias inside the keystore.
# KEY_ALIAS=nia

# Key password (CI secret — never commit a real value).
# KEY_PASSWORD=

# ─── Feature flags ────────────────────────────────────────────────────────────

# Enable Arc blockchain integration (v0.2+). Set to "true" to activate.
NIA_ARC_ENABLED=false

# Enable verbose HTTP logging in debug builds.
NIA_HTTP_LOGGING=false
